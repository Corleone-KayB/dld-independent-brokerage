generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMINISTRATOR
  COMPLIANCE_MANAGER
  SALES_MANAGER
  PARTNER_MANAGER
  BROKER
  PARTNER_COMPANY
  PROPERTY_OWNER
  DEVELOPER
  BUYER
  TENANT
  INVESTOR
  MARKETING_MANAGER
  FINANCE_MANAGER
  SUPPORT_AGENT
}

enum PartnerType {
  INDEPENDENT_BROKER
  BROKERAGE_COMPANY
  PROPERTY_OWNER
  DEVELOPER
  INVESTOR
  CORPORATE_PARTNER
  SERVICE_PROVIDER
}

enum PartnerStatus {
  PENDING_VERIFICATION
  UNDER_REVIEW
  APPROVED
  REJECTED
  MORE_INFORMATION_REQUIRED
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  PLATFORM_VERIFIED
  OFFICIAL_SOURCE_VERIFIED
  EXPIRED
  REJECTED
}

enum PropertyPurpose {
  BUY
  RENT
  COMMERCIAL
  OFF_PLAN
  LUXURY
  INVESTMENT
  HOLIDAY
}

enum PropertyType {
  APARTMENT
  VILLA
  TOWNHOUSE
  PENTHOUSE
  OFFICE
  RETAIL
  WAREHOUSE
  LAND
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VIEWING
  NEGOTIATION
  OFFER
  CONTRACT
  CLOSED
  LOST
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ComplianceDocumentType {
  TRADE_LICENSE
  BROKER_CARD
  PROFESSIONAL_CREDENTIAL
  IDENTIFICATION
  AGREEMENT
  OTHER
}

// --- Phase 2 ---

enum DealStage {
  VIEWING
  OFFER
  NEGOTIATION
  MOU
  CONTRACT
  PAYMENT
  TRANSFER
  COMMISSION
  CLOSED
  CANCELLED
}

enum CommissionStatus {
  PENDING
  EXPECTED
  APPROVED
  PAID
  DISPUTED
}

enum LeadVisibility {
  PRIVATE
  MARKETPLACE
}

// --- Phase 3: DLD Independent Brokerage Network ---

enum NetworkConnectionStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  REVOKED
}

enum ReferralStatus {
  SENT
  ACCEPTED
  DECLINED
  IN_PROGRESS
  CONVERTED
  CLOSED
  EXPIRED
  CANCELLED
}

enum DealCollaboratorRole {
  LISTING_BROKER
  BUYER_BROKER
  REFERRING_BROKER
  CO_BROKER
}

enum DealCollaboratorStatus {
  INVITED
  ACCEPTED
  DECLINED
  REMOVED
}

enum CommissionSplitStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum PropertyShareStatus {
  ACTIVE
  REVOKED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles                    UserRole[]
  partner                  Partner?
  broker                   Broker?
  activities               Activity[]
  auditLogs                AuditLog[]        @relation("ActorAuditLogs")
  blogPosts                BlogPost[]
  referralsAccepted        Referral[]        @relation("ReferralAcceptedBy")
  commissionSplitsApproved CommissionSplit[] @relation("CommissionSplitApprovedBy")
}

model UserRole {
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
}

model Partner {
  id                      String             @id @default(cuid())
  type                    PartnerType
  status                  PartnerStatus      @default(PENDING_VERIFICATION)
  companyName             String?
  mobile                  String?
  email                   String?
  brokerNumber            String?
  orn                     String?
  specialization          String?
  areas                   String[]
  experienceYears         Int?
  acceptedTermsAt         DateTime?
  verificationStatus      VerificationStatus @default(PENDING)
  officialVerificationUrl String?
  lastVerifiedAt          DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  user                User?                @relation(fields: [userId], references: [id])
  userId              String?              @unique
  applications        PartnerApplication[]
  brokers             Broker[]
  properties          Property[]
  clients             Client[]
  leads               Lead[]
  appointments        Appointment[]
  complianceDocuments ComplianceDocument[]
  auditLogs           AuditLog[]
  developer           Developer?
  deals               Deal[]
  commissions         Commission[]
  referralsAsReferrer Referral[]           @relation("ReferringPartner")
  referralsAsReceiver Referral[]           @relation("ReceivingPartner")
  commissionSplits    CommissionSplit[]
}

model PartnerApplication {
  id               String        @id @default(cuid())
  partnerId        String?
  type             PartnerType
  fullName         String
  email            String
  mobile           String
  company          String?
  role             String?
  brokerNumber     String?
  orn              String?
  brokerage        String?
  specialization   String?
  areas            String[]
  experienceYears  Int?
  licenseInfo      String?
  practiceCardInfo String?
  businessFocus    String[]
  acceptedTerms    Boolean       @default(false)
  status           PartnerStatus @default(PENDING_VERIFICATION)
  reviewNotes      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  partner   Partner?   @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  auditLogs AuditLog[]

  @@index([status])
}

model Broker {
  id                      String             @id @default(cuid())
  userId                  String             @unique
  partnerId               String?
  slug                    String             @unique
  name                    String
  photoUrl                String?
  bio                     String?
  languages               String[]
  specializations         String[]
  areasServed             String[]
  experienceYears         Int?
  brokerNumber            String?
  orn                     String?
  verificationStatus      VerificationStatus @default(PENDING)
  officialVerificationUrl String?
  lastVerifiedAt          DateTime?
  rating                  Float?
  // Phase 3: DLD Independent Brokerage Network
  networkOptIn            Boolean            @default(false)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner      Partner?      @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  properties   Property[]
  leads        Lead[]        @relation("AssignedBroker")
  appointments Appointment[]
  deals        Deal[]
  commissions  Commission[]

  connectionsInitiated  NetworkConnection[]       @relation("ConnectionRequester")
  connectionsReceived   NetworkConnection[]       @relation("ConnectionRecipient")
  conversations         ConversationParticipant[]
  messagesSent          Message[]
  referralsSent         Referral[]                @relation("ReferringBroker")
  referralsReceived     Referral[]                @relation("ReceivingBroker")
  dealCollaborations    DealCollaborator[]
  commissionSplits      CommissionSplit[]
  propertySharesOwned   PropertyShare[]           @relation("SharingBroker")
  propertySharesGranted PropertyShare[]           @relation("RecipientBroker")
  reviewsGiven          BrokerReview[]            @relation("ReviewerBroker")
  reviewsReceived       BrokerReview[]            @relation("RevieweeBroker")

  @@index([networkOptIn])
}

model Property {
  id                 String             @id @default(cuid())
  slug               String             @unique
  title              String
  description        String?
  purpose            PropertyPurpose
  propertyType       PropertyType
  status             PropertyStatus     @default(DRAFT)
  price              Decimal            @db.Decimal(18, 2)
  rentalPrice        Decimal?           @db.Decimal(18, 2)
  sizeSqft           Float?
  bedrooms           Int?
  bathrooms          Int?
  furnishing         String?
  completionStatus   String?
  community          String?
  building           String?
  city               String             @default("Dubai")
  latitude           Float?
  longitude          Float?
  developerName      String?
  completionDate     DateTime?
  serviceCharge      Decimal?           @db.Decimal(18, 2)
  rentalYield        Float?
  roi                Float?
  paymentPlan        String?
  amenities          String[]
  view               String?
  parkingSpaces      Int?
  verificationStatus VerificationStatus @default(PENDING)
  partnerId          String?
  brokerId           String?
  // Phase 2: off-plan project linkage
  projectId          String?
  // Phase 2: Property Owner Portal ("List My Property")
  ownerName          String?
  ownerEmail         String?
  ownerPhone         String?
  matchRequested     Boolean            @default(false)
  // Phase 2: automated marketing / SEO
  seoTitle           String?
  seoDescription     String?
  viewCount          Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  partner      Partner?        @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  broker       Broker?         @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  images       PropertyImage[]
  leads        Lead[]
  appointments Appointment[]
  deals        Deal[]
  shares       PropertyShare[]

  @@index([purpose, status])
  @@index([community])
  @@index([price])
  @@index([bedrooms])
  @@index([projectId])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  alt        String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
}

model Client {
  id                   String   @id @default(cuid())
  partnerId            String
  name                 String
  phone                String?
  email                String?
  nationality          String?
  intent               String?
  budget               Decimal? @db.Decimal(18, 2)
  preferredLocations   String[]
  propertyRequirements String?
  financingStatus      String?
  leadSource           String?
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  partner      Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  leads        Lead[]
  activities   Activity[]
  appointments Appointment[]
  deals        Deal[]

  @@index([partnerId])
}

model Lead {
  id          String          @id @default(cuid())
  partnerId   String
  clientId    String?
  propertyId  String?
  brokerId    String?
  source      String?
  status      LeadStatus      @default(NEW)
  temperature LeadTemperature @default(WARM)
  score       Int?
  message     String?
  budget      Decimal?        @db.Decimal(18, 2)
  // Phase 2: Lead Marketplace
  visibility  LeadVisibility  @default(PRIVATE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  partner          Partner    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  client           Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  property         Property?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  broker           Broker?    @relation("AssignedBroker", fields: [brokerId], references: [id], onDelete: SetNull)
  activities       Activity[]
  deal             Deal?
  referralAsSource Referral?  @relation("ReferralSourceLead")
  referralAsResult Referral?  @relation("ReferralResultingLead")

  @@index([partnerId, status])
  @@index([brokerId, status])
  @@index([visibility])
}

model Activity {
  id        String   @id @default(cuid())
  partnerId String?
  clientId  String?
  leadId    String?
  userId    String
  type      String
  note      String
  createdAt DateTime @default(now())

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id])

  @@index([clientId, createdAt])
  @@index([leadId, createdAt])
}

model Appointment {
  id         String            @id @default(cuid())
  partnerId  String
  clientId   String?
  brokerId   String?
  propertyId String?
  startsAt   DateTime
  endsAt     DateTime?
  status     AppointmentStatus @default(SCHEDULED)
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  partner  Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  client   Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  broker   Broker?   @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([partnerId, startsAt])
  @@index([propertyId])
}

model ComplianceDocument {
  id                 String                 @id @default(cuid())
  partnerId          String
  type               ComplianceDocumentType
  name               String
  storageKey         String
  mimeType           String?
  expiresAt          DateTime?
  verificationStatus VerificationStatus     @default(PENDING)
  verifiedAt         DateTime?
  verifiedById       String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, verificationStatus])
  @@index([expiresAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String?
  action        String
  entityType    String
  entityId      String?
  partnerId     String?
  applicationId String?
  metadata      Json?
  createdAt     DateTime @default(now())

  actor       User?               @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)
  partner     Partner?            @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  application PartnerApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([partnerId, createdAt])
}

// --- Phase 2: Developer Portal ---

model Developer {
  id                      String             @id @default(cuid())
  partnerId               String             @unique
  slug                    String             @unique
  name                    String
  logoUrl                 String?
  description             String?
  verificationStatus      VerificationStatus @default(PENDING)
  officialVerificationUrl String?
  lastVerifiedAt          DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  partner  Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  projects Project[]
}

model Project {
  id             String         @id @default(cuid())
  developerId    String
  slug           String         @unique
  name           String
  description    String?
  status         PropertyStatus @default(DRAFT)
  community      String?
  city           String         @default("Dubai")
  completionDate DateTime?
  brochureUrl    String?
  amenities      String[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  developer  Developer      @relation(fields: [developerId], references: [id], onDelete: Cascade)
  units      ProjectUnit[]
  images     ProjectImage[]
  properties Property[]

  @@index([developerId, status])
  @@index([community])
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model ProjectUnit {
  id           String         @id @default(cuid())
  projectId    String
  unitNumber   String?
  propertyType PropertyType
  bedrooms     Int?
  bathrooms    Int?
  sizeSqft     Float?
  price        Decimal        @db.Decimal(18, 2)
  paymentPlan  String?
  status       PropertyStatus @default(PUBLISHED)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

// --- Phase 2: Deal Management + Commission Management ---

model Deal {
  id         String    @id @default(cuid())
  partnerId  String
  leadId     String?   @unique
  clientId   String?
  propertyId String?
  brokerId   String?
  stage      DealStage @default(VIEWING)
  value      Decimal?  @db.Decimal(18, 2)
  deadline   DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  partner       Partner            @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  lead          Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client        Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  property      Property?          @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  broker        Broker?            @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  documents     DealDocument[]
  commission    Commission?
  collaborators DealCollaborator[]

  @@index([partnerId, stage])
  @@index([brokerId, stage])
}

model DealDocument {
  id         String   @id @default(cuid())
  dealId     String
  name       String
  storageKey String
  mimeType   String?
  createdAt  DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

model Commission {
  id             String           @id @default(cuid())
  dealId         String           @unique
  partnerId      String
  brokerId       String?
  amount         Decimal          @db.Decimal(18, 2)
  status         CommissionStatus @default(PENDING)
  approvedAt     DateTime?
  paidAt         DateTime?
  disputedReason String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  deal    Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  partner Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  broker  Broker?           @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  splits  CommissionSplit[]

  @@index([partnerId, status])
  @@index([brokerId, status])
}

// --- Phase 2: Advanced Analytics ---

model EnquiryLog {
  id         String   @id @default(cuid())
  type       String
  propertyId String?
  brokerId   String?
  partnerId  String?
  createdAt  DateTime @default(now())

  @@index([type, createdAt])
  @@index([propertyId])
  @@index([brokerId])
}

// --- Phase 2: Automated Marketing (scoped) ---

model BlogPost {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  excerpt        String?
  content        String
  coverImageUrl  String?
  status         PropertyStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  authorId       String?
  publishedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
}

model Banner {
  id        String    @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  ctaLabel  String?
  ctaHref   String?
  placement String    @default("HOMEPAGE")
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([placement, isActive, sortOrder])
}

// --- Phase 3: DLD Independent Brokerage Network ---

// Consent gate for direct messaging only (decision: referrals/collaboration/
// sharing do NOT require a prior connection — see docs/ARCHITECTURE.md).
// brokerAId/brokerBId store the pair in a canonical (lower cuid, higher cuid)
// order so a request can never be duplicated in both directions; requesterId
// records who actually initiated it.
model NetworkConnection {
  id          String                  @id @default(cuid())
  brokerAId   String
  brokerBId   String
  requesterId String
  status      NetworkConnectionStatus @default(REQUESTED)
  respondedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  brokerA Broker @relation("ConnectionRequester", fields: [brokerAId], references: [id], onDelete: Cascade)
  brokerB Broker @relation("ConnectionRecipient", fields: [brokerBId], references: [id], onDelete: Cascade)

  @@unique([brokerAId, brokerBId])
  @@index([brokerBId, status])
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  brokerId       String
  lastReadAt     DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  broker       Broker       @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@unique([conversationId, brokerId])
  @@index([brokerId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderBrokerId String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Broker       @relation(fields: [senderBrokerId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// Unifies spec's "Exchange leads" (sourceLeadId set) and "Refer clients"
// (clientSnapshot* set, no existing lead yet) into one dispute-safe model.
// Terms are two-stage and immutable once accepted: proposedSplitPercent is
// what was sent; acceptedSplitPercent/acceptedAt/acceptedByUserId are set
// exactly once, at acceptance, and application code must never update them
// again (no counter-offers in v1 — a pending proposal that needs to change
// is cancelled and resent, never edited in place).
model Referral {
  id                   String         @id @default(cuid())
  referringBrokerId    String
  referringPartnerId   String
  receivingBrokerId    String
  receivingPartnerId   String
  sourceLeadId         String?        @unique
  clientSnapshotName   String?
  clientSnapshotPhone  String?
  clientSnapshotEmail  String?
  clientSnapshotBudget Decimal?       @db.Decimal(18, 2)
  requirementNotes     String?
  proposedSplitPercent Decimal?       @db.Decimal(5, 2)
  proposedAt           DateTime       @default(now())
  acceptedSplitPercent Decimal?       @db.Decimal(5, 2)
  acceptedAt           DateTime?
  acceptedByUserId     String?
  status               ReferralStatus @default(SENT)
  declineReason        String?
  resultingLeadId      String?        @unique
  resultingDealId      String?
  expiresAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  referringBroker  Broker  @relation("ReferringBroker", fields: [referringBrokerId], references: [id], onDelete: Cascade)
  referringPartner Partner @relation("ReferringPartner", fields: [referringPartnerId], references: [id], onDelete: Cascade)
  receivingBroker  Broker  @relation("ReceivingBroker", fields: [receivingBrokerId], references: [id], onDelete: Cascade)
  receivingPartner Partner @relation("ReceivingPartner", fields: [receivingPartnerId], references: [id], onDelete: Cascade)
  sourceLead       Lead?   @relation("ReferralSourceLead", fields: [sourceLeadId], references: [id], onDelete: SetNull)
  resultingLead    Lead?   @relation("ReferralResultingLead", fields: [resultingLeadId], references: [id], onDelete: SetNull)
  acceptedByUser   User?   @relation("ReferralAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([referringBrokerId, status])
  @@index([receivingBrokerId, status])
}

// Additive to the existing Deal.brokerId (which stays the untouched primary
// broker). A deal with zero collaborator rows behaves exactly as it did in
// Phase 2 — this table only ever adds participants, never replaces one.
model DealCollaborator {
  id              String                 @id @default(cuid())
  dealId          String
  brokerId        String
  role            DealCollaboratorRole
  splitPercent    Decimal?               @db.Decimal(5, 2)
  status          DealCollaboratorStatus @default(INVITED)
  invitedByUserId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@unique([dealId, brokerId])
  @@index([dealId, status])
  @@index([brokerId, status])
}

// Each split is independently approved/paid — Finance may pay one
// beneficiary's split while another remains under review. amount is
// snapshotted at creation from commission.amount * percent/100 and is
// never recomputed if the parent commission is later corrected.
model CommissionSplit {
  id               String                @id @default(cuid())
  commissionId     String
  brokerId         String
  partnerId        String
  percent          Decimal               @db.Decimal(5, 2)
  amount           Decimal               @db.Decimal(18, 2)
  status           CommissionSplitStatus @default(PENDING)
  rejectionReason  String?
  approvedByUserId String?
  approvedAt       DateTime?
  paidAt           DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  commission     Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  broker         Broker     @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  partner        Partner    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  approvedByUser User?      @relation("CommissionSplitApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([commissionId, status])
  @@index([brokerId, status])
}

// A unilateral grant (not a two-way request) from the owning broker — the
// recipient doesn't need to "accept" to gain view access; ownership of the
// underlying Property never transfers. Acting on it (bringing a buyer)
// happens through a separate DealCollaborator invite, which does have its
// own accept/decline gate.
model PropertyShare {
  id                 String              @id @default(cuid())
  propertyId         String
  sharingBrokerId    String
  sharedWithBrokerId String
  status             PropertyShareStatus @default(ACTIVE)
  createdAt          DateTime            @default(now())
  revokedAt          DateTime?

  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sharingBroker   Broker   @relation("SharingBroker", fields: [sharingBrokerId], references: [id], onDelete: Cascade)
  recipientBroker Broker   @relation("RecipientBroker", fields: [sharedWithBrokerId], references: [id], onDelete: Cascade)

  @@unique([propertyId, sharedWithBrokerId])
  @@index([sharedWithBrokerId, status])
}

// Peer-broker reviews only, gated (at the application layer) to a reviewer
// who was the counterpart on a CLOSED deal collaboration or a
// CONVERTED/CLOSED referral with the reviewee. Deliberately its own model
// (not a shared/polymorphic "Review" table) so a future client-facing
// review system can be added later without touching or weakening this one.
model BrokerReview {
  id               String   @id @default(cuid())
  reviewerBrokerId String
  revieweeBrokerId String
  dealId           String?
  referralId       String?
  rating           Int
  comment          String?
  createdAt        DateTime @default(now())

  reviewer Broker @relation("ReviewerBroker", fields: [reviewerBrokerId], references: [id], onDelete: Cascade)
  reviewee Broker @relation("RevieweeBroker", fields: [revieweeBrokerId], references: [id], onDelete: Cascade)

  @@index([revieweeBrokerId])
  @@index([reviewerBrokerId, dealId])
  @@index([reviewerBrokerId, referralId])
}
