generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMINISTRATOR
  COMPLIANCE_MANAGER
  SALES_MANAGER
  PARTNER_MANAGER
  BROKER
  PARTNER_COMPANY
  PROPERTY_OWNER
  DEVELOPER
  BUYER
  TENANT
  INVESTOR
  MARKETING_MANAGER
  FINANCE_MANAGER
  SUPPORT_AGENT
}

enum PartnerType {
  INDEPENDENT_BROKER
  BROKERAGE_COMPANY
  PROPERTY_OWNER
  DEVELOPER
  INVESTOR
  CORPORATE_PARTNER
  SERVICE_PROVIDER
}

enum PartnerStatus {
  PENDING_VERIFICATION
  UNDER_REVIEW
  APPROVED
  REJECTED
  MORE_INFORMATION_REQUIRED
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  PLATFORM_VERIFIED
  OFFICIAL_SOURCE_VERIFIED
  EXPIRED
  REJECTED
}

enum PropertyPurpose {
  BUY
  RENT
  COMMERCIAL
  OFF_PLAN
  LUXURY
  INVESTMENT
  HOLIDAY
}

enum PropertyType {
  APARTMENT
  VILLA
  TOWNHOUSE
  PENTHOUSE
  OFFICE
  RETAIL
  WAREHOUSE
  LAND
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VIEWING
  NEGOTIATION
  OFFER
  CONTRACT
  CLOSED
  LOST
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ComplianceDocumentType {
  TRADE_LICENSE
  BROKER_CARD
  PROFESSIONAL_CREDENTIAL
  IDENTIFICATION
  AGREEMENT
  OTHER
}

// --- Phase 2 ---

enum DealStage {
  VIEWING
  OFFER
  NEGOTIATION
  MOU
  CONTRACT
  PAYMENT
  TRANSFER
  COMMISSION
  CLOSED
  CANCELLED
}

enum CommissionStatus {
  PENDING
  EXPECTED
  APPROVED
  PAID
  DISPUTED
}

enum LeadVisibility {
  PRIVATE
  MARKETPLACE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles      UserRole[]
  partner    Partner?
  broker     Broker?
  activities Activity[]
  auditLogs  AuditLog[] @relation("ActorAuditLogs")
  blogPosts  BlogPost[]
}

model UserRole {
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
}

model Partner {
  id                      String             @id @default(cuid())
  type                    PartnerType
  status                  PartnerStatus      @default(PENDING_VERIFICATION)
  companyName             String?
  mobile                  String?
  email                   String?
  brokerNumber            String?
  orn                     String?
  specialization          String?
  areas                   String[]
  experienceYears         Int?
  acceptedTermsAt         DateTime?
  verificationStatus      VerificationStatus @default(PENDING)
  officialVerificationUrl String?
  lastVerifiedAt          DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  user                User?                @relation(fields: [userId], references: [id])
  userId              String?              @unique
  applications        PartnerApplication[]
  brokers             Broker[]
  properties          Property[]
  clients             Client[]
  leads               Lead[]
  appointments        Appointment[]
  complianceDocuments ComplianceDocument[]
  auditLogs           AuditLog[]
  developer           Developer?
  deals               Deal[]
  commissions         Commission[]
}

model PartnerApplication {
  id               String        @id @default(cuid())
  partnerId        String?
  type             PartnerType
  fullName         String
  email            String
  mobile           String
  company          String?
  role             String?
  brokerNumber     String?
  orn              String?
  brokerage        String?
  specialization   String?
  areas            String[]
  experienceYears  Int?
  licenseInfo      String?
  practiceCardInfo String?
  businessFocus    String[]
  acceptedTerms    Boolean       @default(false)
  status           PartnerStatus @default(PENDING_VERIFICATION)
  reviewNotes      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  partner   Partner?   @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  auditLogs AuditLog[]

  @@index([status])
}

model Broker {
  id                      String             @id @default(cuid())
  userId                  String             @unique
  partnerId               String?
  slug                    String             @unique
  name                    String
  photoUrl                String?
  bio                     String?
  languages               String[]
  specializations         String[]
  areasServed             String[]
  experienceYears         Int?
  brokerNumber            String?
  orn                     String?
  verificationStatus      VerificationStatus @default(PENDING)
  officialVerificationUrl String?
  lastVerifiedAt          DateTime?
  rating                  Float?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner      Partner?      @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  properties   Property[]
  leads        Lead[]        @relation("AssignedBroker")
  appointments Appointment[]
  deals        Deal[]
  commissions  Commission[]
}

model Property {
  id                 String             @id @default(cuid())
  slug               String             @unique
  title              String
  description        String?
  purpose            PropertyPurpose
  propertyType       PropertyType
  status             PropertyStatus     @default(DRAFT)
  price              Decimal            @db.Decimal(18, 2)
  rentalPrice        Decimal?           @db.Decimal(18, 2)
  sizeSqft           Float?
  bedrooms           Int?
  bathrooms          Int?
  furnishing         String?
  completionStatus   String?
  community          String?
  building           String?
  city               String             @default("Dubai")
  latitude           Float?
  longitude          Float?
  developerName      String?
  completionDate     DateTime?
  serviceCharge      Decimal?           @db.Decimal(18, 2)
  rentalYield        Float?
  roi                Float?
  paymentPlan        String?
  amenities          String[]
  view               String?
  parkingSpaces      Int?
  verificationStatus VerificationStatus @default(PENDING)
  partnerId          String?
  brokerId           String?
  // Phase 2: off-plan project linkage
  projectId          String?
  // Phase 2: Property Owner Portal ("List My Property")
  ownerName          String?
  ownerEmail         String?
  ownerPhone         String?
  matchRequested     Boolean            @default(false)
  // Phase 2: automated marketing / SEO
  seoTitle           String?
  seoDescription     String?
  viewCount          Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  partner      Partner?        @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  broker       Broker?         @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  images       PropertyImage[]
  leads        Lead[]
  appointments Appointment[]
  deals        Deal[]

  @@index([purpose, status])
  @@index([community])
  @@index([price])
  @@index([bedrooms])
  @@index([projectId])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  alt        String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
}

model Client {
  id                   String   @id @default(cuid())
  partnerId            String
  name                 String
  phone                String?
  email                String?
  nationality          String?
  intent               String?
  budget               Decimal? @db.Decimal(18, 2)
  preferredLocations   String[]
  propertyRequirements String?
  financingStatus      String?
  leadSource           String?
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  partner      Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  leads        Lead[]
  activities   Activity[]
  appointments Appointment[]
  deals        Deal[]

  @@index([partnerId])
}

model Lead {
  id          String          @id @default(cuid())
  partnerId   String
  clientId    String?
  propertyId  String?
  brokerId    String?
  source      String?
  status      LeadStatus      @default(NEW)
  temperature LeadTemperature @default(WARM)
  score       Int?
  message     String?
  budget      Decimal?        @db.Decimal(18, 2)
  // Phase 2: Lead Marketplace
  visibility  LeadVisibility  @default(PRIVATE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  partner    Partner    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  client     Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  property   Property?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  broker     Broker?    @relation("AssignedBroker", fields: [brokerId], references: [id], onDelete: SetNull)
  activities Activity[]
  deal       Deal?

  @@index([partnerId, status])
  @@index([brokerId, status])
  @@index([visibility])
}

model Activity {
  id        String   @id @default(cuid())
  partnerId String?
  clientId  String?
  leadId    String?
  userId    String
  type      String
  note      String
  createdAt DateTime @default(now())

  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id])

  @@index([clientId, createdAt])
  @@index([leadId, createdAt])
}

model Appointment {
  id         String            @id @default(cuid())
  partnerId  String
  clientId   String?
  brokerId   String?
  propertyId String?
  startsAt   DateTime
  endsAt     DateTime?
  status     AppointmentStatus @default(SCHEDULED)
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  partner  Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  client   Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  broker   Broker?   @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([partnerId, startsAt])
  @@index([propertyId])
}

model ComplianceDocument {
  id                 String                 @id @default(cuid())
  partnerId          String
  type               ComplianceDocumentType
  name               String
  storageKey         String
  mimeType           String?
  expiresAt          DateTime?
  verificationStatus VerificationStatus     @default(PENDING)
  verifiedAt         DateTime?
  verifiedById       String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, verificationStatus])
  @@index([expiresAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String?
  action        String
  entityType    String
  entityId      String?
  partnerId     String?
  applicationId String?
  metadata      Json?
  createdAt     DateTime @default(now())

  actor       User?               @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)
  partner     Partner?            @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  application PartnerApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([partnerId, createdAt])
}

// --- Phase 2: Developer Portal ---

model Developer {
  id                      String             @id @default(cuid())
  partnerId               String             @unique
  slug                    String             @unique
  name                    String
  logoUrl                 String?
  description             String?
  verificationStatus      VerificationStatus @default(PENDING)
  officialVerificationUrl String?
  lastVerifiedAt          DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  partner  Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  projects Project[]
}

model Project {
  id             String         @id @default(cuid())
  developerId    String
  slug           String         @unique
  name           String
  description    String?
  status         PropertyStatus @default(DRAFT)
  community      String?
  city           String         @default("Dubai")
  completionDate DateTime?
  brochureUrl    String?
  amenities      String[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  developer  Developer      @relation(fields: [developerId], references: [id], onDelete: Cascade)
  units      ProjectUnit[]
  images     ProjectImage[]
  properties Property[]

  @@index([developerId, status])
  @@index([community])
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model ProjectUnit {
  id           String         @id @default(cuid())
  projectId    String
  unitNumber   String?
  propertyType PropertyType
  bedrooms     Int?
  bathrooms    Int?
  sizeSqft     Float?
  price        Decimal        @db.Decimal(18, 2)
  paymentPlan  String?
  status       PropertyStatus @default(PUBLISHED)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

// --- Phase 2: Deal Management + Commission Management ---

model Deal {
  id         String    @id @default(cuid())
  partnerId  String
  leadId     String?   @unique
  clientId   String?
  propertyId String?
  brokerId   String?
  stage      DealStage @default(VIEWING)
  value      Decimal?  @db.Decimal(18, 2)
  deadline   DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  partner    Partner        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  lead       Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client     Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  property   Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  broker     Broker?        @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  documents  DealDocument[]
  commission Commission?

  @@index([partnerId, stage])
  @@index([brokerId, stage])
}

model DealDocument {
  id         String   @id @default(cuid())
  dealId     String
  name       String
  storageKey String
  mimeType   String?
  createdAt  DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

model Commission {
  id             String           @id @default(cuid())
  dealId         String           @unique
  partnerId      String
  brokerId       String?
  amount         Decimal          @db.Decimal(18, 2)
  status         CommissionStatus @default(PENDING)
  approvedAt     DateTime?
  paidAt         DateTime?
  disputedReason String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  broker  Broker? @relation(fields: [brokerId], references: [id], onDelete: SetNull)

  @@index([partnerId, status])
  @@index([brokerId, status])
}

// --- Phase 2: Advanced Analytics ---

model EnquiryLog {
  id         String   @id @default(cuid())
  type       String
  propertyId String?
  brokerId   String?
  partnerId  String?
  createdAt  DateTime @default(now())

  @@index([type, createdAt])
  @@index([propertyId])
  @@index([brokerId])
}

// --- Phase 2: Automated Marketing (scoped) ---

model BlogPost {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  excerpt        String?
  content        String
  coverImageUrl  String?
  status         PropertyStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  authorId       String?
  publishedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
}

model Banner {
  id        String    @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  ctaLabel  String?
  ctaHref   String?
  placement String    @default("HOMEPAGE")
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([placement, isActive, sortOrder])
}
